# --- Java / Maven ---
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
target/
!**/src/main/**/target/
!**/src/test/**/target/

# --- Node / Vue ---
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/
coverage/

# --- Environment ---
.env
!/.env.example
*.local

# --- IDE / OS ---
.idea/
.vscode/
!.vscode/extensions.json
*.iml
*.iws
*.ipr
.DS_Store
*.swp
*~
# Eclipse / Eclipse JDT Language Server (backs the VS Code Java extension).
# `bin/` is its default output folder — the Maven build uses target/ and never
# reads bin/, so everything there is regenerable IDE state.
.project
.classpath
.settings/
bin/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
