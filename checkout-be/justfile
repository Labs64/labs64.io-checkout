APP_NAME := "checkout"
REGISTRY  := "localhost:5005"

# Compile and package the application (skip tests)
build:
    mvn clean package -DskipTests

# Compile, run tests, and package
test:
    mvn clean verify

# Build Docker image and push to local registry
docker: build
    docker build -t {{APP_NAME}}:latest .
    docker tag {{APP_NAME}}:latest {{REGISTRY}}/{{APP_NAME}}:latest
    docker push {{REGISTRY}}/{{APP_NAME}}:latest
    docker images | grep "{{APP_NAME}}"

# Build the application and run it with the local Spring profile
run: build
    mvn spring-boot:run -Dspring-boot.run.profiles=local

# Show available Maven dependency, plugin and property updates, and scan the Docker image for CVEs
check-updates:
    mvn versions:display-plugin-updates -Dmaven.version.ignore='(?i).*[.-]?(alpha|beta|RC|M)\d*'
    mvn versions:display-property-updates -Dmaven.version.ignore='(?i).*[.-]?(alpha|beta|RC|M)\d*'
    mvn versions:display-dependency-updates -DprocessDependencyManagement=false -Dmaven.version.ignore='(?i).*[.-]?(alpha|beta|RC|M)\d*'
    docker scout cves {{APP_NAME}}:latest

# Development tools
# NOTE: `dev-up` only starts services (no auto-restart on code/jar changes).
# To auto-restart `checkout-be` after `mvn package/install`, run `dev-watch`
# (it uses docker-compose `develop.watch`).
#
# Build the application and start the dev services in the background
dev-up:
    mvn -f pom.xml -B -ntp -DskipTests clean install
    docker compose \
      -f docker-compose.dev.yml \
      up -d --build

# Runs in foreground: watches the filesystem and restarts services according to `develop.watch`.
# Tip: run `mvn -DskipTests package` once so the jar exists before starting the container.
#
# Build the application, then watch the filesystem and restart services on changes
dev-watch:
    mvn -f pom.xml -B -ntp -DskipTests clean install
    docker compose \
      -f docker-compose.dev.yml \
      watch

# Stop the dev services, keeping volumes
dev-down:
    docker compose \
      -f docker-compose.dev.yml \
      down

# Follow the last 200 lines of the dev service logs
dev-logs:
    docker compose \
      -f docker-compose.dev.yml \
      logs -f --tail=200

# Full cleanup: stop + remove volumes + remove orphan containers
# Use when you want a fresh Postgres state.
#
# Stop the dev services and remove their volumes and orphan containers
dev-clean:
    docker compose \
      -f docker-compose.dev.yml \
      down -v --remove-orphans
