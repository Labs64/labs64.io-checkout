{
  "name": "checkout-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:dev": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --ui",
    "test": "run-s test:*",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@allindevelopers/vue-local-scope": "^0.3.0",
    "@unhead/vue": "^3.4.3",
    "@vee-validate/i18n": "^4.15.1",
    "@vee-validate/rules": "^4.15.1",
    "@vueuse/integrations": "^15.0.0",
    "axios": "^1.21.1",
    "bootstrap": "^5.3.9",
    "bootstrap-icons": "^1.13.2",
    "bootstrap-vue-next": "^1.2.4",
    "countries-list": "^3.4.1",
    "flag-icons": "^7.6.0",
    "lodash-es": "^4.18.1",
    "nprogress": "^0.2.0",
    "pinia": "^4.1.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.20",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tsconfig/node26": "^26.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-oxlint": "~1.89.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-vue": "~10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.4",
    "oxlint": "~1.89.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.8",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
